{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "url shortener service made with typescript, postgresql, and redis",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx --watch --env-file .env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anuragdotdev/URL-Shortener.git"
  },
  "keywords": [],
  "author": "anuragdotdev",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/anuragdotdev/URL-Shortener/issues"
  },
  "homepage": "https://github.com/anuragdotdev/URL-Shortener#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "nanoid": "^6.0.0",
    "postgres": "^3.4.9",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2"
  }
}
